---
import owner from '../data/owner.js';
---

<section class="min-h-screen relative flex items-center justify-center pt-32 pb-20 overflow-hidden bg-transparent">
    
    <!-- Subtle Gradient Spotlights -->
    <div class="absolute top-[-10%] right-[-10%] w-[800px] h-[800px] bg-purple-900/10 rounded-full blur-3xl opacity-20 pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10 h-full">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-0">
            
            <!-- LEFT: Typography & Content (65%) -->
            <div class="w-full lg:w-[65%] flex flex-col justify-center items-center lg:items-start text-center lg:text-left fade-up order-2 lg:order-1">
                
                <!-- Tagline Pill -->
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 mb-8 backdrop-blur-sm hero-fade-up">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    <span class="text-xs font-mono uppercase tracking-widest text-white/80">{owner.role}</span>
                </div>

                <!-- Main Headline -->
                <h1 class="hero-title text-5xl md:text-7xl lg:text-8xl font-display font-medium text-white leading-tight tracking-tighter mb-8">
                    <span>{owner.firstName}</span>&nbsp;
                    <span class="text-gray-500 italic font-serif font-light">{owner.lastName}</span>
                </h1>

                <!-- Bio / Subtext -->
                <p class="hero-fade-up text-lg md:text-xl text-gray-400 font-light leading-relaxed max-w-lg mb-10 border-l pl-6 border-white/20">
                    {owner.bio}
                </p>

                <!-- CTA Actions -->
                <div class="flex flex-row flex-nowrap items-center justify-center lg:justify-start gap-4 md:gap-6 w-full lg:w-auto">
                    <a href="/projects" class="group relative px-6 py-3 md:px-8 md:py-4 bg-white text-black rounded-full overflow-hidden magnetic shrink-0">
                        <span class="relative z-10 font-bold text-xs md:text-sm uppercase tracking-widest group-hover:text-white transition-colors">See My Work</span>
                        <div class="absolute inset-0 bg-black translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out"></div>
                    </a>
                    
                    <a href="/contact" class="flex items-center gap-2 md:gap-3 text-xs md:text-sm uppercase tracking-widest text-gray-400 hover:text-white transition-colors group whitespace-nowrap">
                        <span>Contact Me</span>
                    </a>
                </div>

            </div>

            <!-- RIGHT: Imagery (35%) -->
            <div class="w-full lg:w-[35%] flex justify-center lg:justify-end items-center order-1 lg:order-2">
                
                <!-- Image Card Wrapper -->
                <div class="relative w-auto h-[40vh] lg:w-full lg:h-auto max-w-[80%] md:max-w-sm aspect-square"> 
                    
                    <!-- Decorative Elements behind image -->
                    <div class="absolute -top-4 -right-4 w-full h-full border border-white/10 rounded-[2rem] z-0"></div>
                    <div class="absolute -bottom-4 -left-4 w-full h-full bg-white/5 rounded-[2rem] z-0 backdrop-blur-sm"></div>

                    <!-- Main Image Container -->
                    <div class="relative w-full h-full rounded-[2rem] overflow-hidden z-10 border border-white/10 shadow-2xl group">
                         <div class="w-full h-full transition-all duration-700">
                             <img 
                                src={owner.avatar} 
                                alt={`${owner.firstName} ${owner.lastName}`} 
                                loading="eager"
                                width="600"
                                height="600"
                                class="w-full h-full object-cover scale-105 group-hover:scale-100 transition-transform duration-700"
                            />
                         </div>
                         
                         <!-- Overlay Gradient -->
                         <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-60"></div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>