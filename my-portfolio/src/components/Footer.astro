---
import owner from '../data/owner.js';

// Combine main and more navigation for the sitemap
const sitemap = [...owner.navigation.main];
const socials = owner.socials;
const currentYear = new Date().getFullYear();

// Check the current URL so we can hide the CTA on the Contact and 404 pages
const currentPath = Astro.url.pathname;
const hideCTA = currentPath.includes('contact') || currentPath.includes('404');
---

<footer class="bg-black/90 pt-24 pb-12 border-t border-white/10 relative overflow-hidden" id="footer">
    
    <div class="container mx-auto px-6 relative z-10">
        
        <!-- Top Section: CTA (Hidden on Contact Page and 404) -->
        {!hideCTA && (
            <div class="text-center mb-24 fade-up">
                <h2 class="text-5xl md:text-8xl font-display font-bold mb-8">Let's work together.</h2>
                <a href="/contact" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-black rounded-full font-bold hover:scale-105 transition-transform magnetic">
                    Start a conversation
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>
        )}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 border-t border-white/10 pt-16">
            
            <!-- Col 1: Sitemap -->
            <div>
                <h4 class="font-bold text-white mb-6">Sitemap</h4>
                <ul class="space-y-3">
                    {sitemap.map((item) => (
                        <li>
                            <a href={item.url} class="text-gray-400 hover:text-white transition-colors relative group">
                                {item.title}
                                <span class="absolute left-0 -bottom-1 w-0 h-[1px] bg-white group-hover:w-full transition-all duration-300"></span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>


            <!-- Col 2: Socials -->
           <div>
                <h4 class="font-bold text-white mb-6">Socials</h4>
                <ul class="space-y-3">
        
                    {socials.map((social) => (
                        <li>
                            <a href={social.url} target="_blank" class="text-gray-400 hover:text-white transition-colors capitalize flex items-center gap-2 group w-fit">
                                {social.platform}
                                <i class={`${social.icon} text-lg`}></i>
                            </a>
                        </li>
                    ))}
                </ul>
            </div> 
        </div>
        
        <div class="flex flex-col md:flex-row justify-between items-center pt-16 mt-16 border-t border-white/5 text-gray-600 text-xs tracking-widest relative">
            <p>&copy; {currentYear} {owner.name}</p>
            <div class="flex items-center gap-2 mt-4 md:mt-0">
                <span class="flex items-center whitespace-nowrap">
                    Designed & Built with ❤️ by 
                    <img src="/assets/img/DB.png" alt="DB" class="w-7 h-7 ml-2" />
                </span>
            </div>
            
            <!-- Back to Top (Fixed Position) -->
            <button id="back-to-top" class="fixed bottom-6 right-6 p-3 md:bottom-8 md:right-8 md:p-4 bg-white/10 rounded-full hover:bg-white text-white hover:text-black transition-all duration-300 opacity-0 translate-y-10 pointer-events-none z-50 shadow-2xl backdrop-blur-md" aria-label="Back to top">
                <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg>
            </button>
        </div>
    </div>
</footer>

<script>
    // Scoped Astro Script for the Back to Top button
    document.addEventListener('DOMContentLoaded', () => {
        const backToTopBtn = document.getElementById('back-to-top');
        if(!backToTopBtn) return;

        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({top: 0, behavior: 'smooth'});
        });

        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) {
                backToTopBtn.classList.remove('opacity-0', 'translate-y-10', 'pointer-events-none');
            } else {
                backToTopBtn.classList.add('opacity-0', 'translate-y-10', 'pointer-events-none');
            }
        });
    });
</script>