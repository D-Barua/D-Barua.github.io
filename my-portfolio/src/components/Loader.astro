<!-- is:inline forces Astro to load this CSS instantly before anything else -->
<style is:inline>
    #page-loader {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        background-color: #050505;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: opacity 0.5s ease-out;
    }
    .loader-spinner {
        position: relative;
        width: 4rem;
        height: 4rem;
        margin-bottom: 1rem;
    }
    .loader-track {
        position: absolute;
        inset: 0;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }
    .loader-fill {
        position: absolute;
        inset: 0;
        border: 4px solid transparent;
        border-top-color: white;
        border-radius: 50%;
        animation: loader-spin 1s linear infinite;
    }
    .loader-text {
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.75rem;
        font-family: monospace;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        animation: loader-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes loader-spin {
        to { transform: rotate(360deg); }
    }
    @keyframes loader-pulse {
        50% { opacity: 0.5; }
    }
</style>

<div id="page-loader">
    <div class="loader-spinner">
        <div class="loader-track"></div>
        <div class="loader-fill"></div>
    </div>
    <span class="loader-text">Loading...</span>
</div>

<!-- is:inline forces the script to run instantly without waiting for bundles -->
<script is:inline>
    window.addEventListener('load', () => {
        const loader = document.getElementById('page-loader');
        if (loader) {
            loader.style.opacity = '0';
            setTimeout(() => {
                loader.style.display = 'none';
            }, 500);
        }
    });
</script>